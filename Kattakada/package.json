{
  "name": "kattakada-sound-on-error",
  "displayName": "Kattakada Sound on Error",
  "description": "Plays a Kattakada sound when code errors are detected.",
  "version": "0.0.1",
  "publisher": "praneeth-reddy-vallem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/praneethreddie/kattakada-sound-on-error"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sound",
    "error",
    "notification",
    "audio",
    "feedback"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kattakada.testSound",
        "title": "Kattakada"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.x",
    "typescript": "^5.x"
  }
}